# Por ahora la tienda funciona SIN servidor ni Supabase: catálogo local y pedidos por WhatsApp.
# Cuando quieras volver a conectar todo, poné esto en "true" (y revisá VITE_API_URL).
VITE_CONECTAR_API=false

# URL del backend (Railway). Sólo se usa con VITE_CONECTAR_API=true.
VITE_API_URL=https://boomzapas-server-production.up.railway.app
