# ─── Navegador (Vite) ─────────────────────────────────────────────
# false = la tienda funciona SIN base de datos: catálogo local y pedidos por WhatsApp.
# true  = usa la API de este mismo sitio (funciones de Vercel en /api) con Supabase y Mercado Pago.
VITE_CONECTAR_API=false

# Sólo si la API estuviera en otro dominio. Normalmente se deja vacío.
# VITE_API_URL=

# ─── Servidor (Vercel → Settings → Environment Variables) ─────────
# Estas NO empiezan con VITE_ y nunca llegan al navegador. No las subas a GitHub.
#
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=        (clave "service_role" de Supabase)
# ADMIN_TOKEN=                 (una clave larga y única para entrar al panel)
# MP_ACCESS_TOKEN=             (Access Token de Mercado Pago; APP_USR-…)
# MP_WEBHOOK_SECRET=           (opcional: clave secreta de los webhooks de Mercado Pago)
# SITE_URL=https://boomzapass.vercel.app   (opcional: dirección pública de la tienda)
